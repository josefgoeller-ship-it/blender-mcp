# Copy to .env and adjust. Every value is optional; the server auto-detects sane defaults.

# Full path to the Blender executable. If unset, the server searches PATH and the
# standard "Blender Foundation/Blender <version>" install folders on every fixed drive.
BLENDER_MCP_EXECUTABLE=E:\Program Files\Blender Foundation\Blender 5.1\blender.exe

# Where generated .blend files and renders are written. Relative paths from tools
# are resolved against this directory. Defaults to <project>/output.
BLENDER_MCP_OUTPUT_DIR=

# Live bridge: where the Blender addon listens.
BLENDER_MCP_HOST=127.0.0.1
BLENDER_MCP_PORT=9876

# Seconds to wait for a headless Blender job before giving up.
BLENDER_MCP_TIMEOUT=300

# Local web UI (uv run blender-mcp-web) — optional LLM for server-side generation.
# Without a key, the UI still uploads refs and queues jobs for Cursor/MCP.
BLENDER_MCP_LLM_PROVIDER=openai
BLENDER_MCP_LLM_API_KEY=
BLENDER_MCP_LLM_MODEL=gpt-4.1
# BLENDER_MCP_LLM_BASE_URL=https://api.openai.com/v1
BLENDER_MCP_WEB_PORT=8765
